<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<link rel="stylesheet" href="css/style.css">
</head>
<body>

<!-- ═══════════════ TOP BAR ═══════════════ -->
<header id="topbar">
  <div class="topbar-left">
    <h1 class="topbar-title">{{ title }}</h1>
  </div>
  <div class="topbar-center">
    <input type="search" id="search-input" placeholder="Search… use quotes for phrases, space = AND" autocomplete="off">
  </div>
  <div class="topbar-right">
    <span id="agent-progress" class="agent-progress" aria-live="polite" hidden></span>
    <button class="btn" id="agent-pause" type="button" hidden>Pause Scan &amp; Save</button>
    <button class="btn btn-primary" id="agent-resume" type="button" hidden>Resume Scan</button>
    <button class="btn" id="perf-toggle" type="button" aria-controls="perf-panel" aria-expanded="false">Performance</button>
    <a class="btn" href="settings.html" title="Agent settings and status">Settings</a>
    <span class="stat-pill" id="stat-decks" title="Total presentations">{{ stats.deck_count }} decks</span>
    <span class="stat-pill" id="stat-slides" title="Total slides">{{ stats.slide_count }} slides</span>
    <span class="stat-pill" id="stat-folders" title="Folders">{{ stats.folder_count }} folders</span>
    <span class="topbar-generated">Generated {{ generated_at }}</span>
  </div>
</header>

<!-- Local-only browser performance diagnostics; no automatic upload. -->
<section id="perf-panel" class="perf-panel hidden" aria-label="Performance diagnostics">
  <h2>Performance diagnostics</h2>
  <p>Timings from this browser session. No slide text, paths or search queries are recorded.</p>
  <pre id="perf-summary" aria-live="polite">Loading measurements…</pre>
  <div class="perf-actions">
    <button class="btn" id="perf-refresh" type="button">Refresh</button>
    <button class="btn" id="perf-clear" type="button">Clear samples</button>
    <button class="btn btn-primary" id="perf-download" type="button">Download JSON report</button>
  </div>
</section>

<!-- ═══════════════ MAIN LAYOUT ═══════════════ -->
<div id="app">

  <!-- ── LEFT SIDEBAR ── -->
  <aside id="sidebar">
    <div class="sidebar-section">
      <h3>Quick Filters</h3>
      <div id="quick-filters">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="today">Today</button>
        <button class="filter-btn" data-filter="week">This Week</button>
        <button class="filter-btn" data-filter="month">This Month</button>
        <button class="filter-btn" data-filter="year">This Year</button>
        <!-- Per-year buttons are injected by JS -->
      </div>
      <button class="filter-btn" id="starred-toggle" data-filter="starred">Starred Only</button>
    </div>

    <div class="sidebar-section">
      <h3>File Type</h3>
      <div id="filetype-filters">
        <button class="filter-btn active" data-filetype="all">All</button>
        <button class="filter-btn" data-filetype="pptx">.pptx</button>
        <button class="filter-btn" data-filetype="pdf">.pdf</button>
      </div>
    </div>

    <div class="sidebar-section">
      <h3>Search In</h3>
      <div id="search-scopes" class="scope-list">
        <label><input type="checkbox" data-scope="deck" checked> Deck</label>
        <label><input type="checkbox" data-scope="folder" checked> Folder</label>
        <label><input type="checkbox" data-scope="title" checked> Title</label>
        <label><input type="checkbox" data-scope="subtitle" checked> Subtitle</label>
        <label><input type="checkbox" data-scope="body" checked> Slide Text</label>
        <label><input type="checkbox" data-scope="extra" checked> Additional Text</label>
        <label><input type="checkbox" data-scope="notes" checked> Notes</label>
      </div>
    </div>

    <div class="sidebar-section">
      <h3>Folders</h3>
      <ul id="folder-list" class="sidebar-list"></ul>
    </div>

    <div class="sidebar-section">
      <h3>Presentations</h3>
      <input type="search" id="deck-search" placeholder="Filter decks…" autocomplete="off">
      <ul id="deck-list" class="sidebar-list"></ul>
    </div>
  </aside>

  <!-- ── MAIN CONTENT ── -->
  <main id="content">
    <!-- Dashboard stats row -->
    <section id="dashboard" class="dashboard">
      <div class="dash-card" id="dash-total-decks">
        <div class="dash-number">0</div>
        <div class="dash-label">Presentations</div>
      </div>
      <div class="dash-card" id="dash-total-slides">
        <div class="dash-number">0</div>
        <div class="dash-label">Slides</div>
      </div>
      <div class="dash-card" id="dash-recent">
        <div class="dash-number">0</div>
        <div class="dash-label">Changed This Week</div>
      </div>
    </section>

    <!-- Heatmap -->
    <section id="heatmap-section">
      <div class="section-header heatmap-header">
        <h2>Activity</h2>
        <div class="heatmap-controls">
          <label for="heatmap-window-select">Window</label>
          <select id="heatmap-window-select" aria-label="Heatmap time window"></select>
        </div>
      </div>
      <div id="heatmap-container"></div>
    </section>

    <!-- Active filters display -->
    <div id="active-filters"></div>

    <!-- Grid view toggle & sort -->
    <div class="grid-toolbar">
      <div class="grid-toolbar-left">
        <span id="result-count"></span>
        <span id="result-range"></span>
      </div>
      <div class="grid-toolbar-right">
        <div class="grid-pagination" aria-label="Slide result pages">
          <button class="btn" id="page-prev" type="button">Previous</button>
          <span id="page-indicator">Page 1 of 1</span>
          <button class="btn" id="page-next" type="button">Next</button>
        </div>
        <label>Group:
          <select id="group-select">
            <option value="none">None</option>
            <option value="deck">By Deck</option>
            <option value="day">By Day</option>
            <option value="week">By Week</option>
          </select>
        </label>
        <label class="checkbox-label">
          <input type="checkbox" id="deck-break-toggle"> Wrap per deck
        </label>
        <label>Sort:
          <select id="sort-select">
            <option value="date-desc">Newest first</option>
            <option value="date-asc">Oldest first</option>
            <option value="name-asc">Name A-Z</option>
            <option value="slide-num">Slide #</option>
            <option value="starred">Starred first</option>
          </select>
        </label>
      </div>
    </div>

    <!-- Slide grid -->
    <div id="slide-grid"></div>
  </main>
</div>

<!-- ═══════════════ DETAIL MODAL ═══════════════ -->
<div id="modal-overlay" class="modal-overlay hidden">
  <div id="modal" class="modal">
    <button id="modal-close" class="modal-close" title="Close">&times;</button>
    <div class="modal-body">
      <div class="modal-image-wrap">
        <img id="modal-image" src="" alt="Slide preview">
      </div>
      <div class="modal-meta">
        <h2 id="modal-title">Slide</h2>
        <dl class="meta-dl">
          <dt>Deck</dt>       <dd id="modal-deck"></dd>
          <dt>Slide #</dt>    <dd id="modal-slide-num"></dd>
          <dt>Folder</dt>     <dd id="modal-folder"></dd>
          <dt>Modified</dt>   <dd id="modal-date"></dd>
          <dt>File Size</dt>  <dd id="modal-size"></dd>
          <dt>Starred</dt>    <dd id="modal-star-state"></dd>
        </dl>
        <div id="modal-subtitle-section">
          <h3>Subtitle</h3>
          <pre id="modal-subtitle"></pre>
        </div>
        <div id="modal-text-section">
          <h3>Slide Text</h3>
          <pre id="modal-text"></pre>
        </div>
        <div id="modal-extra-section">
          <h3>Additional Text</h3>
          <pre id="modal-extra"></pre>
        </div>
        <div id="modal-notes-section">
          <h3>Notes</h3>
          <pre id="modal-notes"></pre>
        </div>
        <div class="modal-actions">
          <button id="btn-toggle-star" class="btn" title="Star or unstar this slide">Star</button>
          <button id="btn-open-file" class="btn btn-primary" title="Open original file">Open Original</button>
          <button id="btn-copy-path" class="btn" title="Copy file path">Copy Path</button>
          <button id="btn-open-folder" class="btn" title="Open containing folder">Open Folder</button>
        </div>
      </div>
    </div>
    <div class="modal-nav">
      <button id="modal-prev" class="btn" title="Previous slide">&#8592; Prev</button>
      <button id="modal-next" class="btn" title="Next slide">Next &#8594;</button>
    </div>
  </div>
</div>

<script src="js/performance.js"></script>
<script src="js/app.js"></script>
<script src="js/agent-status.js"></script>
</body>
</html>
